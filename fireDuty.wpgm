import wollok.game.*
import escenarios.*


program juego {
    game.width(10)
    game.height(7)
    game.cellSize(50)

    keyboard.w().onPressDo().apagarArriba()
    keyboard.d().onPressDo().apagarALaDerecha()
    keyboard.a().onPressDo().apagarALaIzquierda()
    keyboard.s().onPressDo().apagarAbajo()
    
    menu.iniciar()
    game.start()
    
}